Items: {
	HairDart: {
		DisplayName: Tag Dart
		Tooltip: A dart meant to be used with the Dart Leader.
	}

	DartLeader: {
		DisplayName: Dart Leader
		Tooltip:
			'''
			A weapon designed to shoot darts to tag enemies.
			Tagged enemies will be damaged regardless of distance from the 
			player.
			'''
	}

	WrathfulEye: {
		DisplayName: Wrathful Eye
		Tooltip:
			'''
			A set of glasses that increase damage dealt by the septima's 
			main ability by {0}, but increases EP consumption by {1}.
			'''
	}

	CapacityUpgrade: {
		DisplayName: Capacity Upgrade
		Tooltip: Increases the Dart Leader's upgrade capacity by 1.
	}

	ClearUpgrade: {
		DisplayName: Clear Upgrade
		Tooltip: Clears all upgrades from a Dart Leader.
	}

	DullahanUpgrade: {
		DisplayName: Dullahan Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Increases the dart's damage by {0}.
			'''
	}

	MizuchiUpgrade: {
		DisplayName: Mizuchi Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Makes a reticle in front of the darts that redirects them to 
			the mouse position.
			'''
	}

	NagaUpgrade: {
		DisplayName: Naga Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Allows darts to penetrate enemies.
			'''
	}

	OrochiUpgrade: {
		DisplayName: Orochi Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Deploys a drone that shoots darts at different directions
			'''
	}

	OuroborosUpgrade: {
		DisplayName: Ouroboros Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Triples the tag time and gives a chance to not use ammo.
			'''
	}

	TechnosUpgrade: {
		DisplayName: Technos Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Shoots two additional darts at an angle.
			'''
	}

	VasukiUpgrade: {
		DisplayName: Vasuki Upgrade
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			After tagging an enemy, it shoots another dart to the closest enemy.
			Allows the darts to penetrate the ground.
			'''
	}

	UpgradeComponent: {
		DisplayName: Upgrade Component
		Tooltip: Used to make capacity upgrades for the Dart Leader
	}

	MirrorShard: {
		DisplayName: Mirror Shard
		Tooltip:
			'''
			A shard imbued with the power of the Cyber Diva.
			Allows the user to resurrect with improved abilities after dying.
			'''
	}

	RingOfPerfection: {
		DisplayName: Ring Of Perfection
		Tooltip: The most perfect ring ever created, become perfect.
	}

	Stage1Upgrade: {
		DisplayName: Stabilized Septimal Energy
		Tooltip:
			'''
			A container of septimal energy that ressonates with your septima.
			Can be used to upgrade your septima up to level {0}.
			'''
	}

	UniversalUpgradeItem: {
		DisplayName: Tonic of septima empowerment
		Tooltip:
			'''
			A special recipe that is guaranteed to enhance a septima no matter 
			how powerful it already is.
			'''
	}

	Stage2Upgrade: {
		DisplayName: Safe Septima Enhancer
		Tooltip:
			'''
			A chemical concoction injected in the adept's body that enhances their 
			septima.
			Can be used to upgrade your septima up to level {0}.
			The nurse said it has no adverse effects.
			'''
	}

	Stage3Upgrade: {
		DisplayName: Experimental Septimal Energy
		Tooltip:
			'''
			A container of septimal energy that ressonates with your septima.
			Can be used to upgrade your septima up to level {0}, but can only be 
			used from level {1}.
			'''
	}

	Stage4Upgrade: {
		DisplayName: Adept Spirit
		Tooltip:
			'''
			Remnants of the spirit of a powerful adept long gone.
			Can be used to upgrade your septima up to level {0}, but can only be 
			used from level {1}.
			'''
	}

	Stage5Upgrade: {
		DisplayName: Octimal Spirits
		Tooltip:
			'''
			Leftovers from a septima that transcended it's limits and became an octima.
			Can be used to upgrade your septima up to level {0}, but can only be 
			used from level {1}.
			'''
	}

	ProtectiveBody: {
		SetBonus: Increases septimal damage by {0}%.
		DisplayName: Protective Armor
		Tooltip: Increases septimal damage by {0}%.
	}

	ProtectiveLegs: {
		DisplayName: Protective Boots
		Tooltip: ""
	}

	RuinedDartGun: {
		DisplayName: Damaged Dart Leader
		Tooltip:
			'''
			Barely works, but can be used to shoot darts that tag enemies.
			Tagged enemies will be damaged regardless of distance from the 
			player.
			'''
	}

	QuillBody: {
		SetBonus: Increases EP recovery by {0}% and by {1}% on overheat.
		DisplayName: Quill Uniform
		Tooltip: 
			'''
			Specially made to suit an adept's needs.
			Increases septima damage by {0}%.
			'''
	}

	QuillLegs: {
		DisplayName: Quill Boots
		Tooltip: 
			'''
			Increases movement speed by {0}%.
			'''
	}

	SpiritualStone: {
		DisplayName: Spiritual Stone
		Tooltip: A stone with special properties.
	}
}

UpgradeDescription: {
	Darts:
		'''
		An upgrade for the Dart Leader, only adds the described effect to the 
		first Dart Leader found on the inventory.
		Will override the latest upgrade if applied to a Dart leader with no 
		free upgrade slots.
		'''
	Capacity: Capacity: {0}
	MaxCapacity: Capacity: Max
}

