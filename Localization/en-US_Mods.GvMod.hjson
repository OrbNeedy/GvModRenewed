LevelUpMessage: {
	Regular: Your septima feels stronger.
	DragonVein0: A mysterious force powers your septima.
	DragonVein1: The earth itself empowers your septima.
	DragonVein2: You feel a sudden surge of power.
	DragonVein3: The environment nurtures your septima.
	DragonVein4: A primal power fills you.
	DragonVein5: The planet acknowledges your struggles.
	DragonVein6: Septimal power fills your veins.
}

DragonVeins: {
	Visited: Visited
	Unseen: Unseen
	Visit0: Your septima reacts to the environment.
	Visit1: You feel power surging through the air.
	Visit2: This place feels special.
	Visit3: The ground beneat rumbles with power.
	Visit4: Waves of primal energy spread from this place.
	Visit5: An unseen aura permeates the air.
}

ArmedPhenomenon: {
	AzureStriker: {
		Name: "[c/{0}:Azure Striker]"
		Description:
			'''
			Increased flight time and immunity to fall damage using the earth's 
			magnetic fields.
			Increased defense and damage reduction unless overheated.
			Increased main and secondary damage, as well as EP use and recovery.
			When attacking, shoots a dragon claw at the enemy with immense 
			electromagnetic force, which then returns to the user.
			A glimpse into the terrifying power of a primal dragon.
			'''
	}
}
