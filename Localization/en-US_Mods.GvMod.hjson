Configs: {
	GameplayConfig: {
		DisplayName: Gameplay Config
		Headers.Resurrection: Resurrection

		BossResurrection: {
			Label: Boss Resurrection
			Tooltip:
				'''
				Turn off to disable bosses having a chance to resurrect after dying if they were 
				defeated before. 
				This will not disrupt player resurrection, but make it impossible to accquire 
				resurrection related items.
				'''
		}
	}
}

Skills: {
	Default: {
		DisplayName: None
		Description: No effect.
	}

	AlchemicalField: {
		DisplayName: Alchemical Field
		Description: Temporarily increases the amount of money droped and health recovered.
	}

	Astrasphere: {
		DisplayName: Astrasphere
		Description: Deploys a sphere of electrical force around the player.
	}

	Dragonsphere: {
		DisplayName: Dragonsphere
		Description: Unleashes a close-range plasma sphere that impacts the enemy.
	}

	GalvanicPatch: {
		DisplayName: Galvanic Patch
		Description: Stimulates bioelectric current to recover a small amount of health.
	}

	GalvanicRenewal: {
		DisplayName: Galvanic Renewal
		Description: Stimulates bioelectric current to completely recover health.
	}

	GrandStrizer: {
		DisplayName: Glorious Strizer
		Description: Unleashes an electric blade that scales with remaining health over half the max.
	}

	InfiniteSurge: {
		DisplayName: Infinite Surge
		Description: Prevents EP from depleting for a limited time.
	}

	Luxcalibur: {
		DisplayName: Luxcalibur
		Description: Deploys a large electric blade in the direction to the mouse.
	}

	SeptimalBurst: {
		DisplayName: Septimal Burst
		Description: Channels latent septimal energy to temporarily accelerate EP recovery.
	}

	SeptimalShield: {
		DisplayName: Septimal Shield
		Description: Greadly reduces damage taken for a brief period of time.
	}

	SeptimalSurge: {
		DisplayName: Septimal Surge
		Description: Channels latent septima energy to temporarily increase attack power.
	}

	SplitSecond: {
		DisplayName: Split Second
		Description: Instantly recharges all EP, even while overheating.
	}

	VoltaicChains: {
		DisplayName: Voltaic Chains
		Description: Deploys electrifying chains, the power increases with the number of targets hit.
	}
}

