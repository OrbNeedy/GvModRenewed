			Un objeto usado para enlazar un shader a una ID de shader.
			No fue hecho para usarse como tinte de armadura, pero 
			sientete libre de usarlo así.
			'''
	}

	BrokenNecklace: {
		DisplayName: Collar de gemas
		TrueName: Collar roto
		Tooltip: ""
