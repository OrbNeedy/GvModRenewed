ArmedPhenomenon: {
	AzureStriker: {
		Name: "[c/{0}:Azure Striker]"
		Description:
			'''
			Aumenta el tiempo de vuelo y otorga inmunidad a las caidas usando 
			el campo magnetico de la tierra.
			Aumenta la defensa y reducción de daño a menos que se esté en 
			sobrecalentamiento.
			Aumenta el septimo, el uso y recuperación de EP.
			Al atacar, dispara una garra de dragón al enemigo con fuerzas 
			electromagneticas inmensas, el cual después regresa al usuario.
			Un vistazo al aterrador poder de un dragón primordial.
			'''
	}

	Rebirth: {
		Name: "[c/{0}:{$UI.SeptimaNames.Rebirth}]"
		Description:
			'''
			Moverse por cuerdas o ganchos aumenta la defensa y ataque. Otorga 
			inmunidad a ataques fisicos debiles mientras que se viaja por 
			ganchos.
			Permite el uso de un gancho especial que daña enemigos.
			La habilidad suprema de controlar las almas fue liberada.
			'''
	}
}

PulsarHeadBonus: {
	AzureStriker:
		'''

		Al sobrecalentarse, hay una posibilidad de recuperarse al instante y 
		recuperar un SP cada 20 segundos.
		Cuando se recupera del sobrecalentamiento, libera un rayo.
		'''
	Rebirth:
		'''

		Usar la resurección también activa la resurección de jefes si es 
		posible.
		Revivir a un jefe también revive a todos los jugadores cercanos.
		Cuando revives a jugadores o jefes, entra en un super estado por 
		un corto periodo de tiempo.
		Golpear a enemigos que no sean jefes con menos de 50% de la salud 
		tiene una posibilidad de matarlos instantaneamente, la cual aumenta 
		con salud perdida.
		'''
}

