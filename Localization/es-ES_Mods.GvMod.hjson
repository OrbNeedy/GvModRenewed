			'''
			Un collar hecho de gemas que recolectaste antes.
			No tiene ningún efecto, ¿Verdad?
			'''
		UpgradeTooltip:
			'''
			Un collar que se rompió durante una lucha, salvando tu vida.
			La canción de la musa ahora vive adentro de el, permitiendo 
			resurreción por medio del himno.
			'''
	}

	DjinnBunny: {
		DisplayName: Conejo Djinn
