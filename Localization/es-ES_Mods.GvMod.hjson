Items: {
	HairDart: {
		DisplayName: Dardo
		Tooltip: Un dardo hecho para usarse con el Dart Leader.
	}

	DartLeader: {
		DisplayName: Dart Leader
		Tooltip:
			'''
			Un arma diseñada para disparar dardos que marcan enemigos.
			Enemigos marcados serán dañados sin importar la distancia 
			al jugador.
			'''
	}

	WrathfulEye: {
		DisplayName: Wrathful Eye
		Tooltip:
			'''
			Un par de gafas que aumentan el daño causado por la habilidad 
			principal de la septima por {0}%, pero aumenta el consumo de 
			EP en {1}.
			'''
	}

	CapacityUpgrade: {
		DisplayName: Mejora de capacidad
		Tooltip: Aumenta la capacidad del Dart Leader en 1.
	}

	ClearUpgrade: {
		DisplayName: Despejar mejoras 
		Tooltip: Despeja todas las modificaciones al Dart Leader.
	}

	DullahanUpgrade: {
		DisplayName: Dullahan
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Aumenta el daño del dardo en {0}.
			'''
	}

	MizuchiUpgrade: {
		DisplayName: Mizuchi 
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Hace un retículo en frente de los dardos que los redirige a la 
			posición del mouse.
			'''
	}

	NagaUpgrade: {
		DisplayName: Naga 
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Permite que los dados atraviesen enemigos.
			''' 
	}

	OrochiUpgrade: {
		DisplayName: Orochi 
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Libera un dron que dispara dardos en diferentes direcciones.
			'''
	}

	OuroborosUpgrade: {
		DisplayName: Ouroboros 
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Triplica el tiempo de marca y da la posibilidad de no usar munición.
			'''
	}

	TechnosUpgrade: {
		DisplayName: Technos 
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Dispara dos dardos adicionales en un angulo.
			'''
	}

	VasukiUpgrade: {
		DisplayName: Vasuki 
		Tooltip:
			'''
			{$UpgradeDescription.Darts}
			Después de marcar a un enemigo, dispara otro dardo al enemigo más 
			cercano.
			Permite que los dardos atraviecen el suelo.
			'''
	}

	UpgradeComponent: {
		DisplayName: Componente de mejora
		Tooltip: "Usado para hacer mejoras de capacidad para el Dart Leader."
	}

	MirrorShard: {
		DisplayName: Fragmento de espejo
		Tooltip:
			'''
			Un fragmento imbuido con el poder de la Ciber Diva.
			Permite al usuario revivir con habilidades mejoradas luego de morir.
			'''
	}

	RingOfPerfection: {
		DisplayName: Anillo de la perfección
		Tooltip: El anillo más perfecto jamás creado, vuelvete perfecto.
	}

	Stage1Upgrade: {
		DisplayName: Empoderamiento contenido
		Tooltip:
			'''
			Un contenedor de energía extraña que resona con tu septima.
			Puede usarse para mejorar tu septima hasta nivel 10.
			''' 
	}

	UniversalUpgradeItem: {
		DisplayName: Tonico de empoderamiento de septima
		Tooltip:
			'''
			Una receta especial que garantiza mejorar una septima sin importar lo 
			poderosa que sea.
			''' 
	}
}

UpgradeDescription: {
	Darts:
		'''
		Una mejora para el Dart Leader, solo añade el efecto descrito al primer 
		Dart Leader encontrado en el inventario.
		Va a sobreescribir la ultima mejora si se aplica a un Dart Leader sin 
		espacio libre de mejoras.
		''' 
	Capacity: Capacidad: {0}
	MaxCapacity: Capacidad: Max
}

Buffs: {
	Anthem: {
		DisplayName: Himno
		Description:
			'''
			Revivido por el poder de la Ciber Diva.
			All septimal abilities are increased.
			''' 
	}

	ResurrectionCooldown: {
		DisplayName: Enfriamiento de himno
		Description: Tu cuerpo no puede ser revivido otra vez.
	}

	AlchemicalFieldBuff: {
		DisplayName: Alchemical Field
		Description: Duplica el dinero soltado por enemigos y la salud recuperada por pociones.
	}

	InfiniteSurgeBuff: {
		DisplayName: Infinite Surge
		Description: El EP no puede ser reducido.
	}

	SeptimalBurstBuff: {
		DisplayName: Septimal Burst
		Description: Taza de recuperación de EP aumentada.
	}

	SeptimalShieldBuff: {
		DisplayName: Septimal Shield 
		Description: Reduce el daño tomado.
	}

	SeptimalSurgeBuff: {
		DisplayName: Septimal Surge
		Description: Duplica el daño causado.
	}
}

Configs: {
	GameplayConfig: {
		DisplayName: Configuración de juego
		Headers.Resurrection: Resurección

		BossResurrection: {
			Label: Resurección de jefe
			Tooltip:
				'''
				Apagar para deshabilitar la posibilidad de que los jefes revivan luego de morir 
				si ya fueron derrotados antes.
				Esto no va a alterar la resurección del jugador, pero hará imposible la 
				adquisición de objetos relacionados con resurección.
				'''
		}
	}
}

Skills: {
	Default: {
		DisplayName: Vacío
		Description: Sin efecto
	}

	AlchemicalField: {
		DisplayName: Alchemical Field
		Description: Temporalmente aumenta la cantidad de dinero soltado y salud recuperada.
	}

	Astrasphere: {
		DisplayName: Astrasphere
		Description: Libera una esfera de fuerza electrica alrededor del jugador.
	}

	Dragonsphere: {
		DisplayName: Dragonsphere
		Description: Libera una esfera de plasma de corto rango que impacta a los enemigos.
	}

	GalvanicPatch: {
		DisplayName: Galvanic Patch
		Description: Estimula la corriente bioelectrica para recuperar una pequeña cantidad de salud.
	}

	GalvanicRenewal: {
		DisplayName: Galvanic Renewal
		Description: Estimula la corriente bioelectrica para recuperar toda la salud
	}

	GrandStrizer: {
		DisplayName: Glorious Strizer
		Description: Libera una espada electrica que escala con la salud sobre la mitad del máximo.
	}

	InfiniteSurge: {
		DisplayName: Infinite Surge
		Description: Previene el uso de EP por un tiempo limitado.
	}

	Luxcalibur: {
		DisplayName: Luxcalibur
		Description: Libera una espada electrica en dirección al mouse.
	}

	SeptimalBurst: {
		DisplayName: Septimal Burst
		Description: Canaliza energía septima latente para acelerar la recuperación de EP.
	}

	SeptimalShield: {
		DisplayName: Septimal Shield
		Description: Reduce en gran medida el daño tomado temporalmente.
	}

	SeptimalSurge: {
		DisplayName: Septimal Surge
		Description: Canaliza energía septima latente para aumentar el poder de ataque.
	}

	SplitSecond: {
		DisplayName: Split Second
		Description: Recarga todo el EP instantaneamente, incluso en sobrecalentamiento.
	}

	VoltaicChains: {
		DisplayName: Voltaic Chains
		Description: Deploys electrifying chains, the power increases with the number of targets hit.
	}
}

